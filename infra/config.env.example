# Copy to infra/config.env and fill in. infra/config.env is git-ignored.
#   cp infra/config.env.example infra/config.env

AWS_REGION=ap-south-1                 # Mumbai. Change if your EKS cluster is elsewhere.
CLUSTER_NAME=student-portal-eks       # Use the provided cluster's name if one was given to you.
K8S_VERSION=1.35                      # EKS version for a NEW cluster (standard support to Mar 2027).
ECR_REPOSITORY=student-portal

GITHUB_OWNER=<your-github-username>   # e.g. octocat
GITHUB_REPO=student-portal-eks-gitops
GITHUB_BRANCH=main
GITHUB_ROLE_NAME=github-actions-student-portal-ecr

ARGOCD_VERSION=v3.5.7                 # pinned Argo CD release
APP_NAMESPACE=student-portal
